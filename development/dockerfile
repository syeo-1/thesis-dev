FROM mambaorg/micromamba:2.3-debian12-slim

ARG ENV_FILE=environment-gpu.yml
# Pretend a CUDA driver exists during the build (must match cuda-version in the yml)
ARG CUDA_OVERRIDE=12.5

COPY --chown=$MAMBA_USER:$MAMBA_USER ${ENV_FILE} /tmp/environment.yml

RUN CONDA_OVERRIDE_CUDA=${CUDA_OVERRIDE} \
    micromamba install -y -n base -f /tmp/environment.yml && \
    micromamba clean --all --yes

WORKDIR /workspace
EXPOSE 8888

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--no-browser", "--port=8888"]